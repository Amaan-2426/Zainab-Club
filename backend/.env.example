# Copy this file to .env and fill in real values from the Supabase dashboard.
# Never commit .env or paste the service role key into frontend JavaScript.

PORT=3000

# Optional. Use * while learning locally, then restrict it.
CORS_ORIGIN=*

# Project URL looks like: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Safe to use in some frontend setups later. Still do not put the service role here.
SUPABASE_ANON_KEY=your_anon_public_key

# SERVER ONLY. This key bypasses Row Level Security. Never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Long random secret for admin product/inventory/order APIs.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace_with_a_long_random_secret
